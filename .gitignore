# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ----------------------------------------------------------------- Study Desk
# Your Supabase address and anon key. The anon key is meant to be public — it
# ships inside the web build — but there is no reason to hand it over with the
# source, and a future .env may hold something that is not public.
.env
.env.*
!.env.example

# Local Supabase CLI state: which project this machine is linked to. No
# password in it, but it names your project, and nobody else can use it.
supabase/.temp/

# Test output, written fresh by check.sh on every run.
check-output.txt

# Built apps. Rebuilt from source in one command; 43 MB of noise in a repo.
*.apk
*.aab
*.ipa

# Gradle's own build output for the Android project. /build/ above only covers
# the project root, so this slipped through and staged a 140 KB report.
android/build/
android/.gradle/

# The defect review. It stays on this machine: it names an unfixed way to send
# requests billed to this project's API credit, and an unfixed path to a parent
# account — against a deployment that is live. Not a thing to hand a stranger.
QA_FINDINGS.md

# A scratch copy, kept on this machine only.
test/*.unused
