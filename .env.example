# Copy to .env and fill in from your own Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# These two are compiled into the app by run.sh / build-web.sh / build-android.sh.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# NOT HERE, EVER:
#   the service_role key  -> Supabase keeps it; nothing in this repo needs it
#   the Anthropic API key -> Supabase Edge Function secrets only, so that
#                            nothing on a phone or in a browser can read it
